```gitignore
# Python cache files
__pycache__/
*.py[cod]

# Pytest cache
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Local databases
*.db
*.sqlite
*.sqlite3

# Environment variables and secrets
.env
.env.*

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
```